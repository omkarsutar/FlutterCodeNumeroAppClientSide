  -- Recalculate aggregates for the affected purchase order

  UPDATE purchase_order

  SET

    -- Sum of (item_qty * item_sell_rate)

    po_total_amount = COALESCE((

      SELECT SUM(item_qty * item_sell_rate)

      FROM po_item

      WHERE po_id = COALESCE(NEW.po_id, OLD.po_id)

    ), 0),



    -- Count of line items

    po_line_item_count = COALESCE((

      SELECT COUNT(*)

      FROM po_item

      WHERE po_id = COALESCE(NEW.po_id, OLD.po_id)

    ), 0),



    -- Sum of profit_to_shop values

    profit_to_shop = COALESCE((

      SELECT SUM(profit_to_shop)

      FROM po_item

      WHERE po_id = COALESCE(NEW.po_id, OLD.po_id)

    ), 0),



    -- Always refresh updated_at

    updated_at = NOW()

  WHERE po_id = COALESCE(NEW.po_id, OLD.po_id);



  RETURN NULL;

END;

$$;


