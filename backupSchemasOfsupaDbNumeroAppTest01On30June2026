CREATE FUNCTION public.assign_visit_order() RETURNS trigger
    LANGUAGE plpgsql
    AS $$

BEGIN

  -- If visit_order is not provided, assign the next available number

  IF NEW.visit_order IS NULL THEN

    SELECT COALESCE(MAX(visit_order), 0) + 1

    INTO NEW.visit_order

    FROM route_shop_links

    WHERE route_id = NEW.route_id;

  END IF;

  

  RETURN NEW;

END;

$$;


