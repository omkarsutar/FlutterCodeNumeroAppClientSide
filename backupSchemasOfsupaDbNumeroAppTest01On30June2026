    present text[];
    v_valid boolean;
BEGIN
    -- Step 1: Validate access
    SELECT public.validate_birthdate_access(
        birthdate_id => birthdate_id,
        check_po_id  => true
    )
    INTO v_valid;

    -- Step 2: Exit quietly if validation failed
    IF NOT v_valid THEN
        RETURN;
    END IF;

    -- Step 3: Fetch present_numbers for the given birthdate
    SELECT ARRAY(SELECT x::text FROM unnest(present_numbers) AS x)
    INTO present
    FROM public.birthdates
    WHERE id = birthdate_id;

    -- Rule 1: 2 and 7
    IF '2' = ANY(present) AND '7' = ANY(present) THEN
        included_numbers := ARRAY['2','7'];
        description_en := 'You have good sixth sense, i.e., you know what is going to happen.';
        description_hi := 'आपके पास अच्छी छठी इंद्रिय है, यानी आपको पता होता है कि क्या होने वाला है।';
        description_mr := 'तुमच्याकडे चांगली सहावी इंद्रिय आहे, म्हणजे तुम्हाला काय होणार आहे हे आधीच कळते.';
        RETURN NEXT;
    END IF;

    -- Rule 2: 3 and 7
    IF '3' = ANY(present) AND '7' = ANY(present) THEN
        included_numbers := ARRAY['3','7'];
        description_en := 'Your numbers are good for higher studies.';
        description_hi := 'आपके अंक उच्च शिक्षा के लिए अच्छे हैं।';
        description_mr := 'तुमचे अंक उच्च शिक्षेसाठी चांगले आहेत.';
        RETURN NEXT;
    END IF;

    -- Rule 3: 5 and 8
    IF '5' = ANY(present) AND '8' = ANY(present) THEN
        included_numbers := ARRAY['5','8'];
        description_en := 'You can get a good government job. If you face trouble, check enemy numbers attached to you.';
        description_hi := 'आपको अच्छी सरकारी नौकरी मिल सकती है। यदि परेशानी हो रही है तो अपने शत्रु अंक देखें।';
        description_mr := 'तुम्हाला चांगली सरकारी नोकरी मिळू शकते. जर अडचण येत असेल तर तुमच्याशी जोडलेले शत्रू अंक तपासा.';
        RETURN NEXT;
    END IF;

    -- Rule 4: 4 and 8
    IF '4' = ANY(present) AND '8' = ANY(present) THEN
        included_numbers := ARRAY['4','8'];
