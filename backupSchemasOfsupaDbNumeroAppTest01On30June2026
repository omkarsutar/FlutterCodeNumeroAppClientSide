CREATE FUNCTION public.get_stock_market_info(birthdate_id uuid) RETURNS text
    LANGUAGE plpgsql
    AS $$
DECLARE
    pN integer;
    lN integer;
    valToReturn text;
    arr1 integer[] := ARRAY[3,4,5,6,7,8];
    v_valid boolean;
BEGIN
    -- Step 1: Validate access
    SELECT public.validate_birthdate_access(
        birthdate_id => birthdate_id,
        check_po_id  => true
    )
    INTO v_valid;

    -- Step 2: Exit quietly if validation failed
    IF NOT v_valid THEN
        RETURN NULL;
    END IF;

    -- Step 3: Fetch personality_number and life_path_number
    SELECT personality_number, life_path_number
    INTO pN, lN
    FROM public.birthdates
    WHERE id = birthdate_id;

    -- Step 4: Apply your case logic
    -- Case 1: Neither in arr1
    IF NOT (pN = ANY(arr1)) AND NOT (lN = ANY(arr1)) THEN
        valToReturn := 'Your numbers are good for share market, you can trade as intraday trader or investor';
    END IF;

    -- Case 2: One in arr1, other not
    IF (pN = ANY(arr1) AND NOT (lN = ANY(arr1))) OR (lN = ANY(arr1) AND NOT (pN = ANY(arr1))) THEN
        IF ((pN = ANY(ARRAY[4,8]) AND lN = ANY(ARRAY[1,2,9])) OR (lN = ANY(ARRAY[4,8]) AND pN = ANY(ARRAY[1,2,9]))) THEN
            valToReturn := 'You must study share market at first by doing courses and then start investing, don’t trade on guesses';
        ELSIF ((pN = ANY(ARRAY[5,6]) AND lN = ANY(ARRAY[1,2,9])) OR (lN = ANY(ARRAY[5,6]) AND pN = ANY(ARRAY[1,2,9]))) THEN
            valToReturn := 'Your numbers are good for share market, you can trade as intraday trader or investor';
        ELSIF ((pN = ANY(ARRAY[3,7]) AND lN = ANY(ARRAY[1,2,9])) OR (lN = ANY(ARRAY[3,7]) AND pN = ANY(ARRAY[1,2,9]))) THEN
            valToReturn := 'You are good at analysing the stock, you can start your own advisory or consultancy';
        END IF;
    END IF;

    -- Case 3: Both in arr1
    IF pN = ANY(arr1) AND lN = ANY(arr1) THEN
        IF (pN = ANY(ARRAY[4,8]) AND lN = ANY(ARRAY[4,8])) THEN
            valToReturn := 'You must study share market at first by doing courses and then start investing, don’t trade on guesses';
        ELSIF (pN = ANY(ARRAY[5,6]) AND lN = ANY(ARRAY[5,6])) THEN
            valToReturn := 'Your numbers are good for share market, you can trade as intraday trader or investor';
        ELSIF (pN = ANY(ARRAY[3,7]) AND lN = ANY(ARRAY[3,7])) THEN
            valToReturn := 'You are good at analysing the stock, you can start your own advisory or consultancy';
        ELSIF ((pN,lN) IN ((4,5),(5,4),(4,6),(6,4),(8,5),(5,8),(8,6),(6,8))) THEN
            valToReturn := 'You face both big profits and big losses in stock market, so set your profit target during trading and trade with analysed stop loss';
        ELSIF ((pN,lN) IN ((4,3),(3,4),(4,7),(7,4),(8,3),(3,8),(8,7),(7,8))) THEN
            valToReturn := 'You analyse the stocks in correct manner, you also book profit during paper trading or demo account but when you play with real money you face losses, in such state you must start trading account with another person name having personality or life – path number as 5 or 6 respectively';
        ELSIF ((pN,lN) IN ((5,3),(3,5),(5,7),(7,5),(6,3),(3,6),(6,7),(7,6))) THEN
            valToReturn := 'You are having great numbers for both analysing stocks and trading in stock market';
        END IF;
    END IF;

    RETURN valToReturn;
END;
$$;


