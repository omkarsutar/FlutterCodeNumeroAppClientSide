CREATE FUNCTION public._po_item_count_and_status_adjust(p_po_id uuid) RETURNS void
    LANGUAGE plpgsql
    AS $$

DECLARE

  cnt int;

BEGIN

  IF p_po_id IS NULL THEN

    RETURN;

  END IF;



  SELECT COUNT(*) INTO cnt FROM public.po_item WHERE po_id = p_po_id;



  -- keep po_line_item_count in sync

  UPDATE public.purchase_order

  SET po_line_item_count = cnt

  WHERE po_id = p_po_id

    AND (po_line_item_count IS DISTINCT FROM cnt);



  -- If zero items -> ensure status = 'pending'

  IF cnt = 0 THEN

    UPDATE public.purchase_order

    SET status = 'pending'

    WHERE po_id = p_po_id

      AND status IS DISTINCT FROM 'pending';

    RETURN;

  END IF;



  -- If >=1 item and PO currently pending -> set confirmed

  UPDATE public.purchase_order

  SET status = 'confirmed'

  WHERE po_id = p_po_id

    AND status = 'pending';

END;

$$;


