CREATE FUNCTION public.generate_lucky_unlucky_values(pers_n integer, life_p integer, missing integer[]) RETURNS TABLE(unlucky_numbers integer[], unlucky_colors text[], unlucky_colors_hindi text[], unlucky_colors_marathi text[], lucky_numbers integer[], lucky_colors text[], lucky_colors_hindi text[], lucky_colors_marathi text[], lucky_days text[], lucky_days_hindi text[], lucky_days_marathi text[], numbers_for_remedy integer[], numbers_not_for_remedy integer[])
    LANGUAGE plpgsql
    AS $$DECLARE
    pers_rel RECORD;
    life_rel RECORD;
BEGIN
    -- Fetch planet relation data
    SELECT * INTO pers_rel FROM public.planet_relations WHERE planet_number = pers_n;
    SELECT * INTO life_rel FROM public.planet_relations WHERE planet_number = life_p;

    -- Unlucky numbers/colors
    unlucky_numbers := ARRAY(SELECT DISTINCT unnest(pers_rel.enemy_numbers || life_rel.enemy_numbers));
    unlucky_colors  := ARRAY(SELECT DISTINCT unnest(pers_rel.enemy_colors || life_rel.enemy_colors));
    unlucky_colors_hindi := ARRAY(SELECT DISTINCT unnest(pers_rel.enemy_colors_hindi || life_rel.enemy_colors_hindi));
    unlucky_colors_marathi := ARRAY(SELECT DISTINCT unnest(pers_rel.enemy_colors_marathi || life_rel.enemy_colors_marathi));

    -- Lucky numbers/colors/days
    lucky_numbers := ARRAY(
        SELECT DISTINCT n FROM unnest(pers_rel.friend_numbers || life_rel.friend_numbers) n
        WHERE n <> ALL(unlucky_numbers)
    );
    lucky_colors := ARRAY(
        SELECT DISTINCT c FROM unnest(pers_rel.friend_colors || life_rel.friend_colors) c
        WHERE c <> ALL(unlucky_colors)
    );
    lucky_colors_hindi := ARRAY(
        SELECT DISTINCT c FROM unnest(pers_rel.friend_colors_hindi || life_rel.friend_colors_hindi) c
        WHERE c <> ALL(unlucky_colors_hindi)
    );
    lucky_colors_marathi := ARRAY(
        SELECT DISTINCT c FROM unnest(pers_rel.friend_colors_marathi || life_rel.friend_colors_marathi) c
        WHERE c <> ALL(unlucky_colors_marathi)
    );
    lucky_days := ARRAY(
        SELECT DISTINCT d FROM unnest(pers_rel.friend_day || life_rel.friend_day) d
    );
    lucky_days_hindi := ARRAY(
        SELECT DISTINCT d FROM unnest(pers_rel.friend_day_hindi || life_rel.friend_day_hindi) d
    );
    lucky_days_marathi := ARRAY(
        SELECT DISTINCT d FROM unnest(pers_rel.friend_day_marathi || life_rel.friend_day_marathi) d
    );

    -- Remedy numbers
    numbers_for_remedy := ARRAY(
        SELECT DISTINCT n FROM unnest(missing) n
        WHERE n <> ALL(unlucky_numbers)
    );

    numbers_not_for_remedy := ARRAY(
        SELECT DISTINCT n FROM unnest(missing) n
        WHERE n <> ALL(numbers_for_remedy)
    );

    RETURN NEXT;
END;$$;


