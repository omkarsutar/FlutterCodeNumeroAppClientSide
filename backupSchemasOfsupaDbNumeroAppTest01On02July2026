--

CREATE FUNCTION public.validate_birthdate_access(birthdate_id uuid, check_po_id boolean DEFAULT true) RETURNS boolean
    LANGUAGE plpgsql
    AS $$
DECLARE
    v_po_id uuid;
    v_role text;
BEGIN
    -- Step 0: Get po_id and role_name for the user tied to this birthdate
    SELECT b.po_id, r.role_name
    INTO v_po_id, v_role
    FROM public.birthdates b
    JOIN public.users u ON b.user_id = u.user_id
    JOIN public.rbac_roles r ON u.role_id = r.role_id
    WHERE b.id = birthdate_id;

    -- Step 1: If role is admin, always allow
    IF v_role = 'admin' THEN
        RETURN TRUE;
    END IF;

    -- Step 2: If check_po_id flag is true, validate po_id
    IF check_po_id THEN
        IF v_po_id IS NULL THEN
            RETURN FALSE;
        END IF;
    END IF;

    RETURN TRUE; -- validation passed
END;
$$;


