CREATE FUNCTION public.perform_numerology_analysis() RETURNS trigger
    LANGUAGE plpgsql
    AS $$declare
    d_str TEXT;
    digits INT[];
    pers_n INT; life_p INT; p1 INT; p2 INT; p3 INT; p4 INT; pb INT;
    arr_present TEXT[] := '{}';
    grid TEXT[][] := ARRAY[['','',''],['','',''],['','','']];
    missing INT[] := '{}';
    present INT[] := '{}';   -- NEW array for present numbers
    freq JSONB := '{}'::JSONB;
    i INT;
    temp_char TEXT;

    lp1_end INT;
    lp2_end INT;
    lp3_end INT;
    lp4_end INT;
begin
    d_str := to_char(NEW.birthdate, 'DDMMYYYY');
    digits := ARRAY[
        substring(d_str, 1, 1)::INT,
        substring(d_str, 2, 1)::INT,
        substring(d_str, 3, 1)::INT,
        substring(d_str, 4, 1)::INT,
        substring(d_str, 5, 1)::INT,
        substring(d_str, 6, 1)::INT,
        substring(d_str, 7, 1)::INT,
        substring(d_str, 8, 1)::INT
    ];

    pers_n := public.reduce_to_single_digit(digits[1] + digits[2]);
    life_p := public.reduce_to_single_digit(
        digits[1] + digits[2] + digits[3] + digits[4] + 
        digits[5] + digits[6] + digits[7] + digits[8]
    );

    p1 := public.reduce_to_single_digit(digits[1] + digits[2] + digits[3] + digits[4]);
    p2 := public.reduce_to_single_digit(digits[1] + digits[2] + digits[5] + digits[6] + digits[7] + digits[8]);
    p3 := public.reduce_to_single_digit(p1 + p2);
    p4 := public.reduce_to_single_digit(digits[3] + digits[4] + digits[5] + digits[6] + digits[7] + digits[8]);
    pb := 36 - life_p;

    -- Life period calculations
    lp1_end := 36 - life_p;
    lp2_end := lp1_end + 9;
    lp3_end := lp2_end + 9;
    lp4_end := lp3_end + 1;

    NEW.life_period1 := format('0 - %s', lp1_end);
    NEW.life_period2 := format('%s - %s', lp1_end+1, lp2_end);
    NEW.life_period3 := format('%s - %s', lp2_end+1, lp3_end);
    NEW.life_period4 := format('%s +', lp4_end);

    -- Collect present digits
    FOR i IN 1..8 LOOP
        IF digits[i] > 0 THEN arr_present := array_append(arr_present, digits[i]::TEXT); END IF;
    END LOOP;
    arr_present := array_append(arr_present, pers_n::TEXT);
    arr_present := array_append(arr_present, life_p::TEXT);

    -- Build Lo Shu grid
    FOR i IN 1..cardinality(arr_present) LOOP
        temp_char := arr_present[i];
        CASE temp_char
            WHEN '4' THEN grid[1][1] := grid[1][1] || '4';
            WHEN '9' THEN grid[1][2] := grid[1][2] || '9';
            WHEN '2' THEN grid[1][3] := grid[1][3] || '2';
            WHEN '3' THEN grid[2][1] := grid[2][1] || '3';
            WHEN '5' THEN grid[2][2] := grid[2][2] || '5';
            WHEN '7' THEN grid[2][3] := grid[2][3] || '7';
            WHEN '8' THEN grid[3][1] := grid[3][1] || '8';
            WHEN '1' THEN grid[3][2] := grid[3][2] || '1';
            WHEN '6' THEN grid[3][3] := grid[3][3] || '6';
            ELSE NULL;
        END CASE;
    END LOOP;

    -- Build missing and present arrays
    FOR i IN 1..9 LOOP
        IF NOT (i::TEXT = ANY(arr_present)) THEN
            missing := array_append(missing, i);
        ELSE
            present := array_append(present, i);  -- NEW: collect present numbers
            freq := freq || jsonb_build_object(i::TEXT, (SELECT count(*) FROM unnest(arr_present) x WHERE x = i::TEXT));
        END IF;
    END LOOP;

    -- Call the remedy function
SELECT * INTO NEW.unlucky_numbers,
    NEW.unlucky_colors,
    NEW.unlucky_colors_hindi,
    NEW.unlucky_colors_marathi,
    NEW.lucky_numbers,
    NEW.lucky_colors,
    NEW.lucky_colors_hindi,
    NEW.lucky_colors_marathi,
    NEW.lucky_days,
    NEW.lucky_days_hindi,
    NEW.lucky_days_marathi,
    NEW.numbers_for_remedy,
    NEW.numbers_not_for_remedy
FROM public.generate_lucky_unlucky_values(pers_n, life_p, missing);

    NEW.personality_number := pers_n;
    NEW.life_path_number := life_p;
    NEW.pinnacle1 := p1;
    NEW.pinnacle2 := p2;
    NEW.pinnacle3 := p3;
    NEW.pinnacle4 := p4;
    NEW.pinnacle_base := pb;
    NEW.lo_shu_grid := grid;
    NEW.absent_numbers := missing;
    NEW.present_numbers := present;   -- NEW field
    NEW.number_occurrences := freq;
    NEW.updated_at := now();

    RETURN NEW;
end;$$;


